{
  "name": "couch-jarvis-remote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CouchJarvis mobile remote (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
