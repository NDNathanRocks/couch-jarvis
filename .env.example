# CouchJarvis daemon settings (prefix CJ_). Copy to .env and edit.

# --- Cloud relay (AWS API Gateway WebSocket URL from `sam deploy` output) ---
CJ_RELAY_WS_URL=wss://xxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
# Where the phone PWA is hosted (Vercel URL). QR code points here.
CJ_PWA_BASE_URL=https://couch-jarvis.vercel.app

# --- LAN fallback server (serves /ws, /events, /api/command and the PWA) ---
CJ_LAN_HOST=0.0.0.0
CJ_LAN_PORT=8765
# Optional TLS (e.g. generated with mkcert) enables phone microphone over LAN.
# CJ_LAN_TLS_CERT=C:\certs\lan.pem
# CJ_LAN_TLS_KEY=C:\certs\lan-key.pem

# --- Microsoft Edge / CDP ---
# CJ_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# CJ_EDGE_PROFILE_DIR=C:\Users\you\AppData\Local\CouchJarvis\edge-profile
CJ_CDP_PORT=9222

# --- Speech-to-text ---
CJ_STT_MODEL=large-v3-turbo
CJ_STT_DEVICE=cuda
# Free-tier Groq Whisper fallback
# CJ_GROQ_API_KEY=gsk_...

# --- Router / VLM ---
CJ_ROUTER_PROVIDER=ollama
CJ_OLLAMA_URL=http://127.0.0.1:11434
CJ_OLLAMA_TEXT_MODEL=qwen2.5:7b
CJ_OLLAMA_VLM_MODEL=qwen2.5vl:7b
# CJ_GEMINI_API_KEY=...

# --- Misc ---
# CJ_TELEMETRY_DIR=C:\Users\you\AppData\Local\CouchJarvis\telemetry
CJ_HUD_SCREEN_INDEX=0
CJ_LOG_LEVEL=INFO
