# CouchJarvis daemon settings (prefix CJ_). Copy to .env and edit.

# --- Cloud relay (AWS API Gateway WebSocket URL from `sam deploy` output) ---
CJ_RELAY_WS_URL=wss://xxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
# Where the phone PWA is hosted (Vercel URL). QR code points here.
CJ_PWA_BASE_URL=https://couch-jarvis.vercel.app

# --- LAN fallback server (serves /ws, /events, /api/command and the PWA) ---
CJ_LAN_HOST=0.0.0.0
CJ_LAN_PORT=8765
# Optional TLS (e.g. generated with mkcert) enables phone microphone over LAN.
# CJ_LAN_TLS_CERT=C:\certs\lan.pem
# CJ_LAN_TLS_KEY=C:\certs\lan-key.pem

# --- Microsoft Edge / CDP ---
# CJ_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# CJ_EDGE_PROFILE_DIR=C:\Users\you\AppData\Local\CouchJarvis\edge-profile
CJ_CDP_PORT=9222

# --- Speech-to-text ---
# auto = large-v3-turbo on an NVIDIA GPU, small on a CPU
CJ_STT_MODEL=auto
CJ_STT_DEVICE=auto
# Free-tier Groq Whisper fallback
# CJ_GROQ_API_KEY=gsk_...

# --- Router / VLM ---
# auto = Gemini when CJ_GEMINI_API_KEY is set (local model as backup), else local Ollama
CJ_ROUTER_PROVIDER=auto
CJ_OLLAMA_URL=http://127.0.0.1:11434
# auto = qwen2.5:7b on a GPU, phi4-mini on a CPU
CJ_OLLAMA_TEXT_MODEL=auto
CJ_OLLAMA_VLM_MODEL=qwen2.5vl:7b
# CJ_GEMINI_API_KEY=...

# --- Spoken replies ("Now playing X on YouTube Music") ---
# On by default; change the voice, style or switch it off from the phone (Settings). With no key
# below, free Microsoft Edge neural voices speak, and Windows' own voices work with no internet.
# ElevenLabs sounds best; its free plan gives ~10k characters a month and the daemon stops before
# that is used up (CJ_ELEVENLABS_MONTHLY_CHARS), then falls back to the free voices.
# CJ_ELEVENLABS_API_KEY=sk_...
# CJ_ELEVENLABS_MONTHLY_CHARS=9000

# --- Touchpad / keyboard from paired phones ---
# true: a paired phone can move the cursor and type (like sitting at your keyboard), so only
# pair people you trust. false: phones are limited to media and browser commands.
CJ_REMOTE_INPUT=true

# Opt-in crash reports: a scrubbed error report when the app crashes (no names, addresses or
# what you watch; see pc-daemon/crash_reports.py). Off by default.
CJ_CRASH_REPORTS=false
# Builder only: the Sentry DSN that installer\build.ps1 bakes into builds (public by design).
# CJ_CRASH_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# --- Misc ---
# CJ_TELEMETRY_DIR=C:\Users\you\AppData\Local\CouchJarvis\telemetry
CJ_HUD_SCREEN_INDEX=0
CJ_LOG_LEVEL=INFO
